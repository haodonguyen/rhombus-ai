# Copy to `.env` and adjust. docker-compose.yml supplies dev defaults for anything unset.

# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web
LOG_LEVEL=INFO

# Postgres
POSTGRES_PASSWORD=app
DATABASE_URL=postgres://app:app@postgres:5432/app

# Redis: db0 broker, db1 results, db2 cache
REDIS_URL=redis://redis:6379/2
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_TASK_SOFT_TIME_LIMIT=3600
CELERY_TASK_TIME_LIMIT=3900

# S3 (MinIO in dev). Leave S3_ENDPOINT_URL empty in production to use AWS S3.
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=us-east-1
S3_BUCKET=datasets
S3_ENDPOINT_URL=http://minio:9000
SEED_ROWS=1000
# User-supplied S3 connections: lifetime in seconds, and whether to offer the demo bucket.
S3_CONNECTION_TTL=43200
S3_DEMO_ENABLED=true

# Spark
SPARK_MASTER=local[*]
SPARK_DRIVER_MEMORY=2g
SPARK_SHUFFLE_PARTITIONS=8
SPARK_MAX_PARTITION_BYTES=16m

# LLM: the local Ollama service from docker-compose. No API key needed.
# Empty LLM_BASE_URL disables natural-language patterns; raw regex still works.
LLM_BASE_URL=http://ollama:11434
LLM_MODEL=qwen2.5-coder:3b
LLM_CACHE_TTL=604800
LLM_TIMEOUT_SECONDS=300
OLLAMA_KEEP_ALIVE=24h

# Flower
FLOWER_BASIC_AUTH=admin:admin
