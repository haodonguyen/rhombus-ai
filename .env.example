# Copy to `.env` and adjust. docker-compose.yml supplies dev defaults for anything unset.

# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web
LOG_LEVEL=INFO

# Postgres
POSTGRES_PASSWORD=app
DATABASE_URL=postgres://app:app@postgres:5432/app

# Redis: db0 broker, db1 results, db2 cache
REDIS_URL=redis://redis:6379/2
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_TASK_SOFT_TIME_LIMIT=3600
CELERY_TASK_TIME_LIMIT=3900

# S3 (MinIO in dev). Leave S3_ENDPOINT_URL empty in production to use AWS S3.
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=us-east-1
S3_BUCKET=datasets
S3_ENDPOINT_URL=http://minio:9000
SEED_ROWS=1000

# Spark
SPARK_MASTER=local[*]
SPARK_DRIVER_MEMORY=2g
SPARK_SHUFFLE_PARTITIONS=8
SPARK_MAX_PARTITION_BYTES=16m

# LLM (Claude). Without a key, natural-language patterns are disabled; raw regex still works.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5
LLM_CACHE_TTL=604800
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2

# Flower
FLOWER_BASIC_AUTH=admin:admin
